{
  "flutter": {
    "platforms": {
      "android": {
        "buildConfigurations": {
          ".": {
            "projectId": "YOUR_PROJECT_ID",
            "appId": "YOUR_ANDROID_APP_ID",
            "fileOutput": "android/app/google-services.json"
          }
        }
      },
      "dart": {
        "lib/config/firebase/firebase_options.dart": {
          "projectId": "YOUR_PROJECT_ID",
          "configurations": {
            "android": "YOUR_ANDROID_APP_ID",
            "ios": "YOUR_IOS_APP_ID"
          }
        }
      }
    }
  }
}
