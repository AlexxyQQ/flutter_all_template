<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) backup rules. Backup is disabled in AndroidManifest
     (allowBackup="false"); these rules are a second line of defence if it is
     ever re-enabled: nothing from app storage is copied off the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
