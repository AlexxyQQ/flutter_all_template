# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# FVM Version Cache
.fvm/

# ============================================================
# 🔐 Firebase / Secrets — DO NOT COMMIT REAL CREDENTIALS
# The placeholder versions of these files are tracked in git.
# After running `flutterfire configure`, git will see changes —
# use `git update-index --assume-unchanged <file>` to suppress
# them locally, or add your real files to a private branch.
# ============================================================
# Uncomment these lines to prevent git from tracking real keys:
# android/app/google-services.json
# ios/Runner/GoogleService-Info.plist
# lib/config/firebase/firebase_options.dart
# brick/__brick__/android/app/google-services.json
# brick/__brick__/ios/Runner/GoogleService-Info.plist
# brick/__brick__/lib/config/firebase/firebase_options.dart

# Environment files (real values — never commit). Only *.example.json is tracked.
env/*.json
!env/*.example.json
.env
.env.*
# ============================================================
# Generated code — produced by `rps gen` / CI, never committed
# ============================================================
*.g.dart
*.freezed.dart
*.gr.dart
*.config.dart
*.mocks.dart
lib/config/constants/gen/

# Mason local state & compiled hooks (contain absolute local paths).
# mason-lock.json is machine-specific for local `path:` bricks — regenerate with `mason get`.
.mason/
mason-lock.json
bricks/**/hooks/build/

# Android release signing (never commit)
android/key.properties
*.jks
*.keystore

# Local tool settings
.claude/settings.local.json
