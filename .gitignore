# ============================================================
# SECURITY: nothing below may ever be committed. Only the
# placeholder `*.example` siblings of secret files are tracked.
# ============================================================

# Firebase client config (real values come from `flutterfire configure`).
# Create placeholders with `rps firebase:init`; templates are the *.example files.
google-services.json
GoogleService-Info.plist
firebase.json
.firebaserc
lib/config/firebase/firebase_options.dart
# Firebase / GCP service accounts and admin SDK keys
**/*service-account*.json
**/*-adminsdk-*.json
**/*firebase-adminsdk*.json

# Signing material: keystores, certificates, provisioning, API keys
android/key.properties
**/key.properties
*.jks
*.keystore
*.p8
*.p12
*.pfx
*.pem
*.cer
*.crt
*.key
*.mobileprovision
*.certSigningRequest

# Environment files (real values). Only env/*.example.json is tracked.
env/*.json
!env/*.example.json
.env
.env.*
!.env.example

# Local tool state that may hold tokens or absolute paths
.claude/
.mcp.json
.mason/
mason-lock.json
bricks/**/hooks/build/
bricks/**/hooks/pubspec.lock
pubspec_overrides.yaml
.fvm/

# ============================================================
# Generated code: produced by `rps gen` / CI, never committed
# ============================================================
*.g.dart
*.freezed.dart
*.gr.dart
*.config.dart
*.mocks.dart
lib/config/constants/gen/

# ============================================================
# Build output, symbols, release artefacts
# ============================================================
build/
coverage/
.dart_tool/
.pub-cache/
.pub/
.packages
.flutter-plugins
.flutter-plugins-dependencies
**/doc/api/
**/ios/Flutter/.last_build_id
**/symbols/
*.symbols
app.*.symbols
app.*.map.json
*.dSYM
*.dSYM.zip
*.dsym
*.apk
*.aab
*.ipa
*.tar.gz
/android/app/debug
/android/app/profile
/android/app/release

# Platform build/local state (also covered by android/.gitignore, ios/.gitignore)
android/local.properties
android/.gradle/
ios/Pods/
ios/Flutter/Generated.xcconfig
*.xcuserstate

# Maestro run output
maestro-report*
.maestro/**/screenshots/
.maestro/**/*.mp4

# Logs, OS and IDE junk
*.log
*.class
*.pyc
*.swp
.DS_Store
Thumbs.db
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
node_modules/
*.iml
*.ipr
*.iws
.idea/
# .vscode/ is tracked on purpose (shared launch configs).

# Generated on demand by `rps brick` (tool/sync_brick.dart); never committed.
bricks/project_brick/__brick__/
