{
  // Flavor configs read compile-time config from env/<flavor>.json.
  // Create them first: cp env/dev.example.json env/dev.json (see docs/FLAVORS.md).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "dev",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=env/dev.json"]
    },
    {
      "name": "staging",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=env/staging.json"]
    },
    {
      "name": "prod (profile mode)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "args": ["--dart-define-from-file=env/prod.json"]
    },
    {
      "name": "prod (release mode)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release",
      "args": ["--dart-define-from-file=env/prod.json"]
    },
    {
      "name": "App (no env file, defaults)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    }
  ]
}
